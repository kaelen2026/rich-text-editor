{
  "name": "@kaelen/rich-text-editor",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm lint:to-dom && biome check .",
    "check:fix": "biome check --write .",
    "lint:to-dom": "node scripts/lint-to-dom.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/benchmark.ts",
    "demo:remote-image-service": "pnpm --filter @kaelen/remote-image-service-demo dev",
    "render": "tsx scripts/render.ts",
    "dev": "pnpm --filter @kaelen/playground dev",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,css}": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@kaelen/editor-api": "workspace:*",
    "@kaelen/editor-plugin-image": "workspace:*",
    "@kaelen/editor-plugin-link": "workspace:*",
    "@kaelen/editor-plugin-table": "workspace:*",
    "@kaelen/editor-pm-adapter": "workspace:*",
    "@kaelen/editor-runtime": "workspace:*",
    "@kaelen/editor-ui-model": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "axe-core": "^4.13.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "prosemirror-model": "^1.25.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
